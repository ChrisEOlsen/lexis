# Pipeline configuration template (spec sections 5.2.1, 6).
# Copy to lexis.conf and fill in. Settings not yet wired up (chunk
# size/overlap for ingestion, the Unix socket path for the deferred
# Python sidecar) are tracked in LIMITATIONS.md.

# mode = testing | production
#   testing (default if unset): full pipeline observability logging
#     (queries/query_formulation_runs/search_runs/search_results/
#     generation_runs -- see query_log.c) is active on every query.
#   production: that logging is skipped entirely. Measured overhead is
#     small (~2.5ms p50 on top of a ~5ms bare BM25 search, see
#     LIMITATIONS.md) but non-zero, so production traffic can opt out
#     rather than pay it.
mode=testing

# model_path = <path to .gguf, relative to the project root>
#   The local GGUF model every binary (CLI, app, eval harness) loads via
#   llama.cpp. Optional: if unset, falls back to LEXIS_DEFAULT_MODEL_PATH
#   in include/config.h. scripts/download_model.sh reads this line to
#   decide what to download.
model_path=data/models/gemma-4-E4B-it-Q4_K_M.gguf

# thinking = on | off
#   Whether answer generation runs the model's reasoning pass (roughly
#   3x answer latency when on; see LIMITATIONS.md's generation.c row).
#   Only gates the user-facing answer steps -- routing, expansion, and
#   summarization never think. Default if unset: on.
thinking=on

# reranker_model_path = <path to an embedding .gguf, relative to the
#   project root>
#   Optional meaning-based reranker: reorders BM25's candidates by
#   embedding similarity before the trim (see reranker.h). Unset = off.
reranker_model_path=data/models/bge-small-en-v1.5-f16.gguf

# db_conninfo = <libpq connection string>
#   Where the index and chat history live. REQUIRED. Use the password
#   you chose when creating the `lexis` role (docs/building.md). This
#   example file is tracked in git; your real config/lexis.conf is not,
#   so the password never enters version control.
db_conninfo=host=127.0.0.1 port=5434 dbname=lexis user=lexis password=CHANGE_ME
