# Build artifacts
*.o
*.a
*.out
/build/
/lexis
/app/build/

# Generated index (rebuilt from data/corpus via ingest)
/data/index/*
!/data/index/.gitkeep

# Local LLM model weights (large binaries, fetched via scripts/download_model.sh)
/data/models/*
!/data/models/.gitkeep

# MS MARCO corpus export (~3GB, regenerated by scripts/export_msmarco.sh)
/corpus_csv.tsv

# Test corpora fetched from third parties (DelucionQA is Jeep owner's-manual
# text redistributed via RAGBench) -- refetch with scripts/fetch_delucionqa.py
# rather than committing someone else's document text into this repo.
/data/eval/*
!/data/eval/.gitkeep

# Python sidecar
__pycache__/
*.pyc
.venv/
venv/

# Secrets
.env

# Claude Code project-local commands/settings
.claude/
.claude-mode

# OS/editor cruft
.DS_Store
.obsidian/
/.cache/

# qmlls config -- holds an absolute path to the local build tree
**/.qmlls.ini

# VSCode workspace settings -- same reason as .qmlls.ini above: pins
# absolute paths to this machine's Homebrew qmlls and build tree.
/.vscode/
