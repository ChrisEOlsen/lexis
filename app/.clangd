# Points clangd at this subtree's real, CMake-generated compile
# commands (app/build/compile_commands.json -- regenerated by `cmake -S
# . -B build`, see CMakeLists.txt's CMAKE_EXPORT_COMPILE_COMMANDS
# comment) instead of falling back to the repo root's compile_flags.txt,
# which was written for the C core (-std=c11, no Qt include paths) and
# is wrong for everything under app/. clangd resolves configs by
# nearest-enclosing-directory, so this only affects files under app/ --
# src/core/*.c elsewhere in the tree keeps using the root's
# compile_flags.txt untouched.
CompileFlags:
  CompilationDatabase: build
